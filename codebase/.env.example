# ==========================================
# MULTI-PROVIDER LLM CONFIGURATION
# ==========================================

# Provider lựa chọn: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=gemini

# Tên mô hình LLM tương ứng
# Với Gemini: gemini-3.6-flash, gemini-2.5-flash, gemini-2.0-flash
# Với OpenAI: gpt-4o, gpt-4o-mini
# Với Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
LLM_MODEL=gemini-3.6-flash

# API Keys (Điền key thật vào file .env, KHÔNG commit .env)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
