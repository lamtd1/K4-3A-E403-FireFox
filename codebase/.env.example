# ==========================================
# OPENAI-COMPATIBLE LLM CONFIGURATION
# ==========================================
# Dùng được với bất kỳ provider nào hỗ trợ chuẩn chat-completions của OpenAI:
# OpenAI, Groq, router nội bộ (vd LM Studio, 9router...), hoặc Gemini/Anthropic
# qua lớp tương thích OpenAI của chính họ. Chỉ cần đổi 3 biến dưới đây.

# "openai-compatible" (mặc định, gọi API thật) | "mock" (giả lập, dùng khi test/offline)
LLM_PROVIDER=openai-compatible

# Địa chỉ gốc API, không có "/chat/completions" ở cuối
# Ví dụ: https://api.openai.com/v1 | https://api.groq.com/openai/v1 |
#        http://localhost:20128/v1 (router nội bộ)
LLM_BASE_URL=https://api.openai.com/v1

# Tên model theo đúng provider đang dùng
LLM_MODEL=gpt-4o-mini

# API Key thật (điền vào file .env, KHÔNG commit .env)
LLM_API_KEY=your_api_key_here
